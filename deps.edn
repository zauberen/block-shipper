{:paths ["src" "resources"]
 :deps {org.clojure/clojure        {:mvn/version "1.12.0"}
        ;; Web server
        ring/ring-core             {:mvn/version "1.14.1"}
        ring/ring-jetty-adapter    {:mvn/version "1.14.1"}
        compojure/compojure        {:mvn/version "1.7.1"}
        ; HTML rendering
        hiccup/hiccup              {:mvn/version "2.0.0-RC5"}

        ;; Database
        ; Cold storage stuff
        org.xerial/sqlite-jdbc     {:mvn/version "3.49.1.0"}
        org.clojure/java.jdbc      {:mvn/version "0.7.12"}
        ; Password hashing
        buddy/buddy-hashers        {:mvn/version "2.0.167"}
        ; Cache storage (sessions)
        com.taoensso/carmine       {:mvn/version "3.4.1"}
        ; Parse sessions from the cache db
        org.clojure/data.json      {:mvn/version "2.5.1"}

        ;; Logging via clojure logging, wrapping slf4j
        org.slf4j/slf4j-simple     {:mvn/version "2.0.17"}
        org.slf4j/log4j-over-slf4j {:mvn/version "2.0.17"}
        org.slf4j/jul-to-slf4j     {:mvn/version "2.0.17"}
        org.slf4j/jcl-over-slf4j   {:mvn/version "2.0.17"}
        org.clojure/tools.logging  {:mvn/version "1.3.0"}}
 :aliases {:dev  {:jvm-opts     ["-Dclojure.tools.logging.factory=clojure.tools.logging.impl/slf4j-factory"]
                  :extra-paths  ["tests" "repl"]}
           :chk  {:extra-deps   {olical/depot {:mvn/version "2.3.0"}}
                  :main-opts    ["-m" "depot.outdated.main" "-a" "outdated"]}
           :test {:jvm-opts     ["-Dclojure.tools.logging.factory=clojure.tools.logging.impl/slf4j-factory"]
                  :extra-paths  ["tests"]
                  :extra-deps   {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                  :main-opts    ["-m" "kaocha.runner"]}}}
